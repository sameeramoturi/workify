# ==============================================================================
# WORKIFY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=True

# Django Backend Configuration
SECRET_KEY=super-secret-django-production-key-change-this
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database Configuration
POSTGRES_DB=workify_db
POSTGRES_USER=workify_user
POSTGRES_PASSWORD=workify_secret
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgres://workify_user:workify_secret@postgres:5432/workify_db

# Redis Cache & Message Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Machine Learning Microservice
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=5001
ML_SERVICE_URL=http://ml-service:5001

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_ML_URL=http://localhost:5001

# AWS Credentials & S3 Storage (For DevOps / Production)
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_STORAGE_BUCKET_NAME=workify-media-storage
AWS_S3_REGION_NAME=ap-south-1
